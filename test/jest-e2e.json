{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["@swc/jest", {
      "jsc": {
        "parser": {
          "syntax": "typescript",
          "decorators": true,
          "dynamicImport": true
        },
        "target": "es2021",
        "keepClassNames": true,
        "transform": {
          "legacyDecorator": true,
          "decoratorMetadata": true
        }
      },
      "module": {
        "type": "commonjs"
      }
    }]
  },
  "transformIgnorePatterns": [],
  "testTimeout": 60000
}
