PORT=3004
SWAGGER_PORT=3005
JWT_SECRET=your-super-secret-key-change-in-production
USER_MANAGEMENT_URL=http://localhost:3001
# Comma-separated list of allowed origins (no trailing slash).
# For Render + Vercel production, add your Vercel frontend URL:
#   CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://tu-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Feature flags
# Football-duel is disabled by default — the project is focused on shooter-arena.
# Set to "true" and restart the backend to re-enable the football minigame.
FOOTBALL_DUEL_ENABLED=false
