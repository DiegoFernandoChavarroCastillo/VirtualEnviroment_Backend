
# Puerto del servidor HTTP
PORT=3004

# Redis — requerido para almacenamiento efímero de posiciones y presencia
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT — DEBE ser idéntico al JWT_SECRET de peerly-authentication-management
# Si los valores no coinciden, todos los eventos WebSocket fallarán con AUTH_ERROR
JWT_SECRET=your-super-secret-key-change-in-production

# URLs de otros microservicios
USER_MANAGEMENT_URL=http://localhost:3000
CONNECTION_MANAGEMENT_URL=http://localhost:3003
